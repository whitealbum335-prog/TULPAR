<Window x:Class="Tulpar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tulpar | Rocket Simulator"
        Width="1180"
        Height="800"
        MinWidth="900"
        MinHeight="650"
        Background="#0B1020"
        Foreground="#F4F6FC"
        FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#151D30" />
    <SolidColorBrush x:Key="MutedBrush" Color="#929DB4" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F4B544" />
    <Style x:Key="MetricCard" TargetType="Border">
      <Setter Property="Background" Value="#151D30" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14,11" />
      <Setter Property="Margin" Value="0,0,9,0" />
    </Style>
    <Style x:Key="InputBox" TargetType="TextBox">
      <Setter Property="Background" Value="#0E1525" />
      <Setter Property="Foreground" Value="#F4F6FC" />
      <Setter Property="BorderBrush" Value="#2A3650" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="CaretBrush" Value="#F4B544" />
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="Background" Value="#F4B544" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Foreground" Value="#E4E9F3" />
      <Setter Property="Background" Value="#27334A" />
    </Style>
  </Window.Resources>

  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="150" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,20">
      <StackPanel>
        <TextBlock FontSize="12" FontWeight="Bold" Foreground="#F4B544"
                   Text="TULPAR" />
        <TextBlock Margin="0,5,0,0" FontSize="25" FontWeight="SemiBold"
                   Text="Rocket Simulator" />
      </StackPanel>
      <Border HorizontalAlignment="Right" VerticalAlignment="Center"
              Background="#151D30" CornerRadius="14" Padding="12,7">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#929DB4"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock x:Name="StatusText" Foreground="#C7D0E0" FontSize="12"
                     Text="READY" VerticalAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="290" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" CornerRadius="16" Background="#151D30"
              Padding="14" Margin="0,0,16,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" CornerRadius="10" ClipToBounds="True">
            <Canvas x:Name="SceneCanvas" Background="#101A2A" SizeChanged="SceneCanvas_SizeChanged" />
          </Border>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="3,12,0,0">
            <TextBlock Foreground="#929DB4" FontSize="11"
                       Text="VERTICAL FLIGHT  •  STANDARD ATMOSPHERE" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="1" CornerRadius="16" Background="{StaticResource PanelBrush}"
              Padding="18">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Rocket setup" />
            <TextBlock Margin="0,4,0,16" Foreground="{StaticResource MutedBrush}"
                       FontSize="12" Text="Set the vehicle and motor parameters." />

            <TextBlock Foreground="#C7D0E0" FontSize="12" Text="Dry mass (kg)" />
            <TextBox x:Name="DryMassInput" Style="{StaticResource InputBox}" Text="30" Margin="0,5,0,12" />

            <TextBlock Foreground="#C7D0E0" FontSize="12" Text="Propellant mass (kg)" />
            <TextBox x:Name="PropellantInput" Style="{StaticResource InputBox}" Text="20" Margin="0,5,0,12" />

            <TextBlock Foreground="#C7D0E0" FontSize="12" Text="Engine thrust (N)" />
            <TextBox x:Name="ThrustInput" Style="{StaticResource InputBox}" Text="1200" Margin="0,5,0,12" />

            <TextBlock Foreground="#C7D0E0" FontSize="12" Text="Burn duration (s)" />
            <TextBox x:Name="BurnDurationInput" Style="{StaticResource InputBox}" Text="5" Margin="0,5,0,12" />

            <TextBlock Foreground="#C7D0E0" FontSize="12" Text="Drag coefficient" />
            <TextBox x:Name="DragCoefficientInput" Style="{StaticResource InputBox}" Text="0.5" Margin="0,5,0,16" />

            <Button x:Name="LaunchButton" Style="{StaticResource ActionButton}"
                    Content="Launch simulation" Click="LaunchButton_Click" />
            <Grid Margin="0,9,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Name="PauseButton" Grid.Column="0" Style="{StaticResource SecondaryButton}"
                      Content="Pause" Click="PauseButton_Click" IsEnabled="False" />
              <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                      Content="Reset" Click="ResetButton_Click" />
            </Grid>

            <TextBlock Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}"
                       FontSize="11" TextWrapping="Wrap"
                       Text="Simplified 1D physics: gravity, altitude-dependent air density, drag, and propellant mass loss." />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="2.1*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource MetricCard}">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="ALTITUDE" />
          <TextBlock x:Name="AltitudeText" Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold" Text="0 m" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource MetricCard}">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="VELOCITY" />
          <TextBlock x:Name="VelocityText" Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold" Text="0 m/s" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource MetricCard}">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="ACCELERATION" />
          <TextBlock x:Name="AccelerationText" Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold" Text="0 m/s²" />
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Style="{StaticResource MetricCard}">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="FLIGHT TIME" />
          <TextBlock x:Name="TimeText" Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold" Text="0.0 s" />
        </StackPanel>
      </Border>
      <Border Grid.Column="4" CornerRadius="12" Background="#151D30" Padding="12,9">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11"
                     Text="ALTITUDE PROFILE (m)" />
          <Canvas x:Name="ChartCanvas" Grid.Row="1" Margin="0,5,0,0"
                  SizeChanged="ChartCanvas_SizeChanged" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
